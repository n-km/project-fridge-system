# Kopieren nach .env und anpassen

# Datenbank (für docker compose wird daraus automatisch DATABASE_URL gebaut)
POSTGRES_PASSWORD=bitte-aendern

# Für lokale Entwicklung ohne Docker:
DATABASE_URL=postgres://pfs:pfs@localhost:5432/pfs
UPLOAD_DIR=./uploads

# true, sobald die App über HTTPS erreichbar ist
COOKIE_SECURE=false
# false = neue Konten nur noch per Einladungscode
ALLOW_REGISTRATION=true
# Ab wie vielen Tagen vor dem MHD ein Artikel „bald fällig“ ist
EXPIRING_SOON_DAYS=3
TZ=Europe/Berlin
PORT=3000
